{
  "name": "telega",
  "version": "0.1.0",
  "description": "Telegram client built with Electron, TypeScript, and TDLib",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -w -p tsconfig.main.json",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "start": "electron .",
    "start:dev": "npm run build && electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "telegram",
    "electron",
    "tdlib",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@prebuilt-tdlib/types": "^0.1008066.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.0.0",
    "concurrently": "^8.2.2",
    "electron": "^43.2.0",
    "electron-builder": "^24.6.4",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tdl": "^8.0.0"
  },
  "optionalDependencies": {
    "prebuilt-tdlib": "^0.1008066.0"
  },
  "build": {
    "appId": "com.telega.app",
    "productName": "Telega",
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "allowScripts": {
    "electron@27.3.11": true,
    "esbuild@0.21.5": true,
    "tdl@8.1.0": true
  }
}
